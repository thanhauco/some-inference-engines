# A customised model: `ollama create support-bot -f examples/ollama/Modelfile`
# then `ollama run support-bot`. Same idea as a Dockerfile, for models.
FROM llama3.1:8b

# Determinism for support answers, and a bigger context window than the 2k-4k default.
PARAMETER temperature 0.2
PARAMETER num_ctx 8192

SYSTEM """You are a concise support assistant for an inference platform.
Answer in at most five sentences. If you are not sure, say so."""
